# Copy this file to .env and fill in your API keys.
# Never commit the actual .env file to version control.

# AbuseIPDB — https://www.abuseipdb.com/account/api
# Free tier: 1,000 checks per day
ABUSEIPDB_API_KEY=

# AlienVault OTX — https://otx.alienvault.com/api
# Free tier: 10,000 requests per hour
OTX_API_KEY=

# Optional: rate limiting and timeouts
ENRICHER_MAX_CONCURRENT_REQUESTS=10
ENRICHER_REQUEST_TIMEOUT=30

# Optional: default paths
ENRICHER_OUTPUT_DIR=./output
